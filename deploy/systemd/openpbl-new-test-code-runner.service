[Unit]
Description=OpenPBL new-platform test code runner (loopback port 3201)
PartOf=openpbl-new-test.service
Before=openpbl-new-test.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/lkj/OpenPBL/openPBL
Environment=OPENPBL_NEW_RUNNER_PORT=3201
ExecStart=/home/lkj/OpenPBL/openPBL/scripts/openpbl-new-test-service.sh run-code-runner
Restart=always
RestartSec=5s
TimeoutStopSec=15s
KillMode=control-group
SuccessExitStatus=143
LimitNOFILE=65535
