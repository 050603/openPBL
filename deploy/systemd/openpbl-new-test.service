[Unit]
Description=OpenPBL new-platform test server (port 3200)
Wants=network-online.target openpbl-new-test-code-runner.service
After=network-online.target openpbl-new-test-code-runner.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/lkj/OpenPBL/openPBL
Environment=OPENPBL_NEW_PORT=3200
Environment=OPENPBL_NEW_RUNNER_PORT=3201
Environment=OPENPBL_PUBLIC_BASE_URL=http://172.16.185.157:3200
ExecStart=/home/lkj/OpenPBL/openPBL/scripts/openpbl-new-test-service.sh run-app
Restart=always
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=30s
KillMode=control-group
SuccessExitStatus=143
LimitNOFILE=65535

[Install]
WantedBy=default.target
