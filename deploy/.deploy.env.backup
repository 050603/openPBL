# OpenPBL 生产部署配置 —— 本机 IP 直访(HTTP)模式
# 服务器内网 IP:172.16.185.157,通过 http://172.16.185.157 访问
PUBLIC_HOST=172.16.185.157
# host 网络模式下无 Docker DNS,Nginx 直接回环到应用端口
OPENPBL_UPSTREAM=127.0.0.1
OPENPBL_IMAGE=openpbl-app:sha-0f25c582e1eefbbfe42b0974513245523d342c13
OPENPBL_MIGRATOR_IMAGE=openpbl-migrator:sha-0f25c582e1eefbbfe42b0974513245523d342c13
# 本部署未启用 backup profile(无 S3),postgres 由 docker-compose.ip.yml 覆盖为官方镜像
OPENPBL_POSTGRES_IMAGE=postgres:16.9-alpine

# backup/certificate 相关 profile 未启用;以下值仅满足 compose 插值校验
BACKUP_S3_ENDPOINT=https://s3.invalid.example
BACKUP_S3_BUCKET=openpbl-backups-unused
BACKUP_S3_REGION=us-east-1

ENABLE_LOAD_TEST_API=false
LOAD_TEST_CLIENT_IP=127.0.0.1
